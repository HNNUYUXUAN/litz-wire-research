  ,hfSTL=FileNameJoin[{hfDir,hfID<>".stl"}];hfMesh=hfTubeMesh[hfPath,g["diameter_m"]/2];hfSTLOut=Export[hfSTL,hfMesh,"STL"];hfSTLBack=Import[hfSTL,"STL"];
