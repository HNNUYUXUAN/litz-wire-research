(* One-case/resumable longitudinal PEEC sensitivity campaign. Historical
   outputs are read only when their run IDs are explicitly supplied. *)
Get[FileNameJoin[{stageRoot,"src","PEEC.wl"}]];
cpDefaults=<|"case_time_budget_seconds"->3600.,"mutual_kernel_method"->"GridOffsets",
 "archive_full_model"->True,"compute_inductance_eigenvalue"->False,
 "length_tolerance"->.01,"spatial_tolerance"->.01,"quadrature_tolerance"->.001,
 "self_tolerance"->.001,"bessel_tolerance"->.01,"port_tolerance"->10.^-8|>;
cpConfigPath=Environment["LITZ_CLOSURE_CONFIG"];
If[!StringQ[cpConfigPath]||cpConfigPath=="",cpConfigPath=FileNameJoin[{stageRoot,"configs","prewrite_closure.json"}]];
If[!StringMatchQ[cpConfigPath,LetterCharacter~~":"~~Alternatives["\\","/"]~~___]&&!StringStartsQ[cpConfigPath,{"\\\\","/"}],cpConfigPath=FileNameJoin[{stageRoot,cpConfigPath}]];
cpRawConfig=If[FileExistsQ[cpConfigPath],Quiet[Check[Import[cpConfigPath,"RawJSON"],$Failed]],<||>];
If[!AssociationQ[cpRawConfig],stageCheck["closure_config_readable",1,0,"closure_configuration"];cpRawConfig=<||>];
cpSection=If[AssociationQ[Lookup[cpRawConfig,"peec",<||>]],Lookup[cpRawConfig,"peec",<||>],<||>];
cpAliases=<||>;
If[KeyExistsQ[cpSection,"maximum_case_seconds"],AssociateTo[cpAliases,"case_time_budget_seconds"->cpSection["maximum_case_seconds"]]];
If[KeyExistsQ[cpSection,"relative_sensitivity_tolerance"],AssociateTo[cpAliases,<|"length_tolerance"->cpSection["relative_sensitivity_tolerance"],"spatial_tolerance"->cpSection["relative_sensitivity_tolerance"],
 "quadrature_tolerance"->cpSection["relative_sensitivity_tolerance"],"self_tolerance"->cpSection["relative_sensitivity_tolerance"]|>]];
cpConfig=Join[cpDefaults,cpAliases,cpSection];
cpConfigValid=And@@(TrueQ[NumericQ[cpConfig[#]]&&cpConfig[#]>0]&/@{"case_time_budget_seconds","length_tolerance","spatial_tolerance","quadrature_tolerance","self_tolerance","bessel_tolerance","port_tolerance"})&&
 MemberQ[{"Pairwise","GridOffsets"},cpConfig["mutual_kernel_method"]];
If[!cpConfigValid,stageCheck["closure_peec_config_valid",1,0,"closure_configuration"];cpConfig=cpDefaults];
cpBudgetText=Environment["LITZ_RAM_BUDGET"];
cpBudget=If[StringQ[cpBudgetText]&&StringMatchQ[cpBudgetText,DigitCharacter..],ToExpression[cpBudgetText],0.];
cpBudgetValid=TrueQ[cpBudget>0];
cpSpecs=Join[
 Table[<|"case_id"->("peec_m40_l"<>row[[1]]<>"_q4_s10p8"),"m"->40,"length_m"->row[[2]],"q"->4,"ag"->10,"pg"->8|>,{row,{{"016",.16},{"032",.32},{"064",.64},{"128",1.28}}}],
 Table[<|"case_id"->("peec_m40_l064_q"<>ToString[q]<>"_s10p8"),"m"->40,"length_m"->.64,"q"->q,"ag"->10,"pg"->8|>,{q,{6,8}}],
 {<|"case_id"->"peec_m40_l064_q4_s12p10","m"->40,"length_m"->.64,"q"->4,"ag"->12,"pg"->10|>},
 Table[<|"case_id"->("peec_m80_l"<>row[[1]]<>"_q4_s10p8"),"m"->80,"length_m"->row[[2]],"q"->4,"ag"->10,"pg"->8|>,{row,{{"032",.32},{"064",.64},{"128",1.28}}}],
 Table[<|"case_id"->("peec_m80_l064_q"<>ToString[q]<>"_s10p8"),"m"->80,"length_m"->.64,"q"->q,"ag"->10,"pg"->8|>,{q,{6,8}}],
 {<|"case_id"->"peec_m80_l064_q4_s12p10","m"->80,"length_m"->.64,"q"->4,"ag"->12,"pg"->10|>}];
cpSelection=Environment["LITZ_CLOSURE_CASE_ID"];
If[!StringQ[cpSelection]||cpSelection=="",cpSelection="peec_m40_l016_q4_s10p8"];
cpSelected=If[cpSelection=="all",cpSpecs,Select[cpSpecs,# ["case_id"]==cpSelection&]];
If[cpSelected=={},stageCheck["closure_peec_known_case",1,0,"closure_configuration"]];
cpPreflightOnly=MemberQ[{"1","true","True"},Environment["LITZ_CLOSURE_PREFLIGHT_ONLY"]];
cpRows={};cpProgress=Null;cpStop=Null;
cpRoot=FileNameJoin[{stageDir,"cases"}];If[!DirectoryQ[cpRoot],CreateDirectory[cpRoot]];
Export[FileNameJoin[{stageDir,"closure_peec_parameters.json"}],<|"run_id"->stageID,"selected_case"->cpSelection,"configuration"->cpConfig,
 "preflight_only"->cpPreflightOnly,"case_definitions"->cpSelected,"RAM_budget_bytes"->cpBudget,"frequency_Hz"->200000,
 "total_current_RMS_A"->20,"conductivity_S_per_m"->5.8*^7,"relative_permeability"->1,"temperature_C"->20,"phasor"->"exp(+j omega t)"|>,"RawJSON"];
cpCheckpoint[event_]:=(cpProgress=event;stageData=<|"source_model"->"prewrite_longitudinal_PEEC_sensitivity","cases"->cpRows,"progress"->event,"first_stop"->cpStop|>;stageSave[];Print[KeyDrop[event,{"currents_RMS_A_ReIm"}]]);
Do[
 cpCaseDir=FileNameJoin[{cpRoot,cpSpec["case_id"]}];CreateDirectory[cpCaseDir];
 cpCaseStart=AbsoluteTime[];cpEstimateN=Length[Select[Tuples[Range[-.001+.001/cpSpec["m"],.001-.001/cpSpec["m"],.002/cpSpec["m"]],2],Norm[#]<=.001&]];
 cpEstimate=128. cpEstimateN^2+32768. cpEstimateN;
 cpPreflight=<|"run_id"->stageID,"case_id"->cpSpec["case_id"],"filaments"->cpEstimateN,"estimated_working_bytes"->cpEstimate,
  "working_budget_bytes"->cpBudget,"soft_fraction"->.7,"measured_allocation"->False,
  "execution_status"->If[cpBudgetValid&&cpEstimate<=.7 cpBudget,"passed","blocked_environment_resource_budget"]|>;
 Export[FileNameJoin[{cpCaseDir,"resource_preflight.json"}],cpPreflight,"RawJSON"];
 Export[FileNameJoin[{cpCaseDir,"parameters.json"}],Join[cpSpec,cpConfig,<|"run_id"->stageID,"working_budget_bytes"->cpBudget|>],"RawJSON"];
 If[!cpBudgetValid||cpEstimate>.7 cpBudget,
  cpSummary=Join[cpSpec,<|"run_id"->stageID,"source_model"->"finite_length_longitudinal_volume_filament_PEEC","execution_status"->"blocked_environment_resource_budget",
   "physical_acceptance_status"->"not_run","failure_reason"->If[!cpBudgetValid,"missing_positive_RAM_budget","predicted_working_set_exceeds_70percent_budget"],"resource_preflight"->cpPreflight|>];
  AppendTo[cpRows,cpSummary];Export[FileNameJoin[{cpCaseDir,"case.json"}],cpSummary,"RawJSON"];cpStop=cpSummary;cpCheckpoint[cpSummary];Break[]];
 If[cpPreflightOnly,
  cpSummary=Join[cpSpec,<|"run_id"->stageID,"source_model"->"longitudinal_PEEC_resource_preflight","execution_status"->"preflight_only","physical_acceptance_status"->"not_run","resource_preflight"->cpPreflight|>];
  AppendTo[cpRows,cpSummary];Export[FileNameJoin[{cpCaseDir,"case.json"}],cpSummary,"RawJSON"];cpCheckpoint[cpSummary];Continue[]];
 cpCheckpoint[<|"phase"->"case_start","case_id"->cpSpec["case_id"],"parameters"->cpSpec|>];
 cpModel=TimeConstrained[LitzPEEC`LongitudinalModel[cpSpec["m"],cpSpec["length_m"],200000.,
  "MutualQuadratureOrder"->cpSpec["q"],"SelfAccuracyGoal"->cpSpec["ag"],"SelfPrecisionGoal"->cpSpec["pg"],
  "MemoryBudgetBytes"->cpBudget,"MutualKernelMethod"->cpConfig["mutual_kernel_method"],
  "ComputeInductanceEigenvalue"->TrueQ[cpConfig["compute_inductance_eigenvalue"]],"ProgressFunction"->cpCheckpoint],cpConfig["case_time_budget_seconds"],$Aborted];
 If[!AssociationQ[cpModel],
  cpSummary=Join[cpSpec,<|"run_id"->stageID,"source_model"->"finite_length_longitudinal_volume_filament_PEEC","execution_status"->If[cpModel===$Aborted,"not_completed_time_budget","failed_numerical"],
   "physical_acceptance_status"->"not_verified","failure_reason"->ToString[cpModel,InputForm],"case_elapsed_seconds"->AbsoluteTime[]-cpCaseStart,"last_progress"->cpProgress|>];
  AppendTo[cpRows,cpSummary];cpStop=cpSummary;Export[FileNameJoin[{cpCaseDir,"case.json"}],cpSummary,"RawJSON"];stageCheck[cpSpec["case_id"]<>"_completed",1,0,"longitudinal_PEEC"];cpCheckpoint[cpSummary];Break[]];
 cpBefore=Length[stageChecks];
 Scan[stageCheck[cpSpec["case_id"]<>"_"<>#,cpModel["solution"][#],cpConfig["port_tolerance"],"longitudinal_PEEC_common_port"]&,
  {"linear_residual","current_residual","common_voltage_residual","power_residual"}];
 stageCheck[cpSpec["case_id"]<>"_reciprocity",cpModel["L_reciprocity_relative_residual"],10.^-12,"volume_pair_integral_symmetry"];
 stageCheck[cpSpec["case_id"]<>"_sampled_inductance_energy",Max[0.,-cpModel["minimum_sampled_L_quadratic_form_H"]],10.^-14,"sampled_forms_not_full_spectrum"];
 cpPassed=!AnyTrue[Drop[stageChecks,cpBefore],#["execution_status"]=="failed"&];
 cpCurrent=cpModel["solution"]["currents"];cpV=cpModel["solution"]["voltage"];cpRdc=cpSpec["length_m"]/(5.8*^7 cpModel["area_m2"]);
 cpSummary=Join[cpSpec,<|"run_id"->stageID,"source_model"->cpModel["source_model"],"execution_status"->If[cpPassed,"passed_case_checks","failed_numerical"],
  "physical_acceptance_status"->"sensitivity_campaign_incomplete","filaments"->cpModel["filaments"],"nominal_copper_area_m2"->cpModel["area_m2"],
  "cell_width_m"->cpModel["cell_width_m"],"axial_length_m"->cpSpec["length_m"],"copper_volume_m3"->cpModel["area_m2"] cpSpec["length_m"],"arc_length_growth"->1.,
  "Rdc_segment_ohm"->cpRdc,"Rdc_ohm_per_axial_m"->cpRdc/cpSpec["length_m"],"Rac_ohm_per_axial_m"->cpModel["Rac_ohm_per_axial_m"],
  "Rac_over_Rdc"->cpModel["Rac_ohm_per_axial_m"]/(cpRdc/cpSpec["length_m"]),"loss_W_segment"->cpModel["solution"]["loss_W"],
  "loss_W_per_axial_m"->cpModel["solution"]["loss_W"]/cpSpec["length_m"],"port_voltage_RMS_V_ReIm"->{Re[cpV],Im[cpV]},
  "complex_filament_current_deviation_L2"->Norm[cpCurrent-20./Length[cpCurrent]]/Norm[cpCurrent],"currents_RMS_A_ReIm"->Map[{Re[#],Im[#]}&,cpCurrent],
  "Bessel_equal_area_Rac_ohm_per_m"->cpModel["Bessel_equal_area_Rac_ohm_per_m"],"Bessel_Rac_relative_error"->cpModel["Bessel_Rac_relative_error"],
  "residuals"->KeyTake[cpModel["solution"],{"linear_residual","current_residual","common_voltage_residual","power_residual"}],
  "assembly_seconds"->cpModel["assembly_seconds"],"self_integral_seconds"->cpModel["self_integral_seconds"],"solve_seconds"->cpModel["solve_seconds"],
  "case_elapsed_seconds"->AbsoluteTime[]-cpCaseStart,"estimated_working_bytes"->cpEstimate,"working_budget_bytes"->cpBudget,
  "inductance_passivity_status"->cpModel["inductance_passivity_status"],"L_reciprocity_relative_residual"->cpModel["L_reciprocity_relative_residual"],
  "scope"->cpModel["scope"],"currents_file"->"currents.csv","full_model_file"->If[TrueQ[cpConfig["archive_full_model"]],"model.wxf",Null]|>];
 Export[FileNameJoin[{cpCaseDir,"currents.csv"}],Prepend[MapThread[Join[#1,{Re[#2],Im[#2],Re[#2]/cpModel["cell_width_m"]^2,Im[#2]/cpModel["cell_width_m"]^2}]&,
  {cpModel["centers_m"],cpCurrent}],{"x_m","y_m","current_RMS_A_real","current_RMS_A_imag","Jz_RMS_A_per_m2_real","Jz_RMS_A_per_m2_imag"}],"CSV"];
 If[TrueQ[cpConfig["archive_full_model"]],Export[FileNameJoin[{cpCaseDir,"model.wxf"}],<|"run_id"->stageID,"case_id"->cpSpec["case_id"],"model"->cpModel|>,"WXF"]];
 Export[FileNameJoin[{cpCaseDir,"case.json"}],cpSummary,"RawJSON"];AppendTo[cpRows,cpSummary];Clear[cpModel,cpCurrent];cpCheckpoint[cpSummary];
 If[!cpPassed,cpStop=cpSummary;Break[]],{cpSpec,cpSelected}];

(* Resume comparisons use only explicit run IDs and their portable case JSON.
   A partial case cannot accidentally turn an incomplete campaign into passed. *)
cpReferenceText=Environment["LITZ_CLOSURE_REFERENCE_RUNS"];
cpReferenceIDs=If[StringQ[cpReferenceText],DeleteCases[StringTrim/@StringSplit[cpReferenceText,","],""],{}];cpReferenceRows={};
Do[If[StringMatchQ[cpRefID,RegularExpression["[A-Za-z0-9_-]+"]],
 cpFiles=FileNames["case.json",LitzEvidence`ReadPath[stageRoot,FileNameJoin[{stageRoot,"outputs",cpRefID,"cases"}]],Infinity];
 Do[cpImported=Quiet[Check[Import[cpFile,"RawJSON"],$Failed]];
  If[AssociationQ[cpImported]&&Lookup[cpImported,"run_id",None]==cpRefID,AppendTo[cpReferenceRows,Append[cpImported,"case_file_absolute"->cpFile]]],{cpFile,cpFiles}]],{cpRefID,cpReferenceIDs}];
cpAllRows=Values[Association[(#["case_id"]->#)&/@Join[cpReferenceRows,cpRows]]];
cpFind[id_]:=SelectFirst[cpAllRows,Lookup[#,"case_id",None]==id&&Lookup[#,"execution_status",None]=="passed_case_checks"&,Missing["NotRun",id]];
cpDifferences={};
cpCompare[id_,before_,after_,tol_,kind_]:=Module[{a=cpFind[before],b=cpFind[after],delta,currentDelta=Null,metric},
 If[AssociationQ[a]&&AssociationQ[b],delta=Abs[b["Rac_ohm_per_axial_m"]/a["Rac_ohm_per_axial_m"]-1];
  If[a["filaments"]==b["filaments"]&&KeyExistsQ[a,"currents_RMS_A_ReIm"]&&KeyExistsQ[b,"currents_RMS_A_ReIm"],
   currentDelta=Norm[Flatten[b["currents_RMS_A_ReIm"]-a["currents_RMS_A_ReIm"]]]/Max[Norm[Flatten[b["currents_RMS_A_ReIm"]]],$MinMachineNumber]];
  metric=If[NumericQ[currentDelta],Max[delta,currentDelta],delta];
  AppendTo[cpDifferences,<|"id"->id,"kind"->kind,"before_case_id"->before,"after_case_id"->after,"before_run_id"->a["run_id"],"after_run_id"->b["run_id"],
   "Rac_relative_change"->delta,"complex_current_relative_change"->currentDelta,"acceptance_metric"->metric,"tolerance"->tol,"execution_status"->If[metric<=tol,"passed","failed"]|>],
  AppendTo[cpDifferences,<|"id"->id,"kind"->kind,"before_case_id"->before,"after_case_id"->after,"execution_status"->"not_run","tolerance"->tol|>]]];
Scan[cpCompare["length_"<>#[[1]]<>"_"<>#[[2]],"peec_m40_l"<>#[[1]]<>"_q4_s10p8","peec_m40_l"<>#[[2]]<>"_q4_s10p8",cpConfig["length_tolerance"],"length"]&,{{"016","032"},{"032","064"},{"064","128"}}];
Scan[cpCompare["fine_length_"<>#[[1]]<>"_"<>#[[2]],"peec_m80_l"<>#[[1]]<>"_q4_s10p8","peec_m80_l"<>#[[2]]<>"_q4_s10p8",cpConfig["length_tolerance"],"fine_length"]&,{{"032","064"},{"064","128"}}];
cpCompare["mutual_q4_to6","peec_m40_l064_q4_s10p8","peec_m40_l064_q6_s10p8",cpConfig["quadrature_tolerance"],"mutual_quadrature"];
cpCompare["mutual_q6_to8","peec_m40_l064_q6_s10p8","peec_m40_l064_q8_s10p8",cpConfig["quadrature_tolerance"],"mutual_quadrature"];
cpCompare["fine_mutual_q4_to6","peec_m80_l064_q4_s10p8","peec_m80_l064_q6_s10p8",cpConfig["quadrature_tolerance"],"mutual_quadrature"];
cpCompare["fine_mutual_q6_to8","peec_m80_l064_q6_s10p8","peec_m80_l064_q8_s10p8",cpConfig["quadrature_tolerance"],"mutual_quadrature"];
cpCompare["self_10p8_to12p10","peec_m40_l064_q4_s10p8","peec_m40_l064_q4_s12p10",cpConfig["self_tolerance"],"self_quadrature"];
cpCompare["fine_self_10p8_to12p10","peec_m80_l064_q4_s10p8","peec_m80_l064_q4_s12p10",cpConfig["self_tolerance"],"self_quadrature"];
Scan[cpCompare["spatial_l"<>#,"peec_m40_l"<>#<>"_q4_s10p8","peec_m80_l"<>#<>"_q4_s10p8",cpConfig["spatial_tolerance"],"transverse_spatial"]&,{"032","064","128"}];
cpLengthRows=Select[cpDifferences,#["kind"]=="length"&&#["execution_status"]!="not_run"&];
cpLengthPassed=Length[cpLengthRows]>=2&&And@@(#["execution_status"]=="passed"&/@Take[cpLengthRows,-2]);
cpFineLengthRows=Select[cpDifferences,#["kind"]=="fine_length"&&#["execution_status"]!="not_run"&];
cpFineLengthPassed=Length[cpFineLengthRows]>=1&&Last[cpFineLengthRows]["execution_status"]=="passed";
cpMutualPassed=Lookup[SelectFirst[cpDifferences,#["id"]=="mutual_q6_to8"&,<||>],"execution_status",None]=="passed";
cpFineMutualPassed=Lookup[SelectFirst[cpDifferences,#["id"]=="fine_mutual_q6_to8"&,<||>],"execution_status",None]=="passed";
cpSelfPassed=Lookup[SelectFirst[cpDifferences,#["id"]=="self_10p8_to12p10"&,<||>],"execution_status",None]=="passed";
cpFineSelfPassed=Lookup[SelectFirst[cpDifferences,#["id"]=="fine_self_10p8_to12p10"&,<||>],"execution_status",None]=="passed";
cpSpatialPassed=Lookup[SelectFirst[cpDifferences,#["id"]=="spatial_l064"&,<||>],"execution_status",None]=="passed";
cpFine=cpFind["peec_m80_l064_q8_s10p8"];If[!AssociationQ[cpFine],cpFine=cpFind["peec_m80_l064_q4_s10p8"]];
cpBesselPassed=AssociationQ[cpFine]&&TrueQ[cpFine["Bessel_Rac_relative_error"]<=cpConfig["bessel_tolerance"]];
cpCampaignStatus=If[cpLengthPassed&&cpFineLengthPassed&&cpMutualPassed&&cpFineMutualPassed&&cpSelfPassed&&cpSpatialPassed&&cpBesselPassed,"passed_longitudinal_scope_only",
 If[AnyTrue[cpDifferences,#["execution_status"]=="failed"&],"failed_numerical","not_verified_incomplete_campaign"]];
cpFinal=<|"run_id"->stageID,"source_model"->"prewrite_longitudinal_PEEC_sensitivity","cases"->cpRows,"reference_run_ids"->cpReferenceIDs,"comparisons"->cpDifferences,
 "length_two_successive_changes_passed"->cpLengthPassed,"fine_length_change_passed"->cpFineLengthPassed,"mutual_quadrature_passed"->cpMutualPassed,"fine_mutual_quadrature_passed"->cpFineMutualPassed,"self_quadrature_passed"->cpSelfPassed,
 "fine_self_quadrature_passed"->cpFineSelfPassed,"transverse_spatial_passed"->cpSpatialPassed,"equal_area_Bessel_passed"->cpBesselPassed,"physical_acceptance_status"->cpCampaignStatus,"first_stop"->cpStop|>;
Export[FileNameJoin[{stageDir,"closure_peec_summary.json"}],cpFinal,"RawJSON"];
stageData=Join[cpFinal,<|"configuration"->cpConfig,"progress"->cpProgress,"failure_reason"->If[cpCampaignStatus=="failed_numerical","sensitivity_threshold_exceeded",Null],
 "assumptions"->"SI; exp(+j omega t); RMS20A; sigma58MS/m; mu_r1;20C. Insulated uniform longitudinal finite-volume filaments with one common end voltage. No imposed equal filament currents, transverse loops, explicit remote return or finite-end redistribution. Equal-area Bessel comparison concerns Rac only; partial X is not internal wire reactance. m40/m80 approximate a single2mm calibration wire, below5mm2. Each comparison changes one length, quadrature or discretization parameter. Sampled inductance energies are not full eigenvalue passivity certification. Preflight estimates are not measured allocation or low32GiB device acceptance. Explicit run IDs only; incomplete campaigns remain not_verified."|>];
stageSave[];
