Cell["Independent kernel execution and native frontend rendering", "Text",
 Evaluatable->False,ExpressionUUID->"4208e294-d95a-c049-8215-6f561b14f849"],

Cell["SI; exp(+j omega t); RMS; sigma=58 MS/m; mu_r=1; 20 C", "Text",
 Evaluatable->False,ExpressionUUID->"6e88ae3a-4bbc-7149-976e-6ca7e9187f55"],

Cell["\<\
Probe the local kernel, then follow the MCP workflow for actual tool and \
Notebook operations.\
\>", "Text",
 Evaluatable->False,ExpressionUUID->"36b79300-6aed-2a45-9900-9ef8ec7961df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivation and interpretation", "Section",
 Evaluatable->False,ExpressionUUID->"99328d7b-dc5b-284d-a2a8-7e15969aee63"],

Cell["\<\
Probe the actual local kernel and arithmetic first. The native Notebook runs \
the same saved task interface as the CLI in an independent process. The MCP \
example separately checks tool discovery, numerical evaluation, TestReport, \
Notebook writing and reading.\
\>", "Text",
 Evaluatable->False,ExpressionUUID->"2e8de642-4d39-154e-9bdc-369325352a6a"],

Cell["\<\
A working connection is distinct from a successful numerical test or field \
acceptance. Record the installed AgentTools version and visible tool schemas \
before using version-specific arguments.\
\>", "Text",
 Evaluatable->False,ExpressionUUID->"bf28d582-4c41-9149-b8db-1bce18b257a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectRoot", "=", 
   RowBox[{"NestWhile", "[", 
    RowBox[{"DirectoryName", ",", 
     RowBox[{"NotebookDirectory", "[", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"#1", ",", "\"\<pyproject.toml\>\""}], "}"}], "]"}], 
         "]"}]}], "&&", 
       RowBox[{
        RowBox[{"DirectoryName", "[", "#1", "]"}], "=!=", "#1"}]}], "&"}]}], 
    "]"}]}], ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "projectRoot", ",", "\"\<shared\>\"", ",", "\"\<wolfram\>\"", 
      ",", "\"\<ResearchNotebook.wl\>\""}], "}"}], "]"}], "]"}], 
  ";"}]], "Input",
 Evaluatable->True,
 InitializationCell->True,
 CellTags->"research-input",
