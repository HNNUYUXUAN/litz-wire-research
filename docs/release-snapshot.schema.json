{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline GitHub release audit snapshot",
  "type": "object",
  "required": ["schema_version", "captured_at", "repository", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "required": ["full_name", "private"],
      "properties": {"full_name": {"type": "string"}, "private": {"type": "boolean"}}
    },
    "releases": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/release"}},
        {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"$ref": "#/$defs/release"}}}
      ]
    },
    "anonymous_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["tag_name", "draft", "published_at", "assets"],
      "properties": {
        "tag_name": {"type": "string"}, "draft": {"type": "boolean"},
        "published_at": {"type": ["string", "null"]},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "size", "state"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 1}, "state": {"type": "string"},
        "digest": {"type": ["string", "null"]},
        "url": {"type": "string", "format": "uri"},
        "browser_download_url": {"type": "string", "format": "uri"}
      }
    },
    "receipt": {
      "type": "object",
      "required": ["asset_id", "release_tag", "authentication", "method", "scope", "status", "bytes", "sha256", "url", "checked_at"],
      "properties": {
        "asset_id": {"type": "integer", "minimum": 1}, "release_tag": {"type": "string"},
        "authentication": {"const": "none"}, "method": {"const": "GET"}, "scope": {"const": "full-body"},
        "status": {"const": 200}, "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "url": {"type": "string", "format": "uri"},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
